pipeline {
  agent any
  stages {
    stage('pull') {
      steps {
        echo 'pull the code'
      }
    }

    stage('test') {
      steps {
        echo 'test the code'
      }
    }

    stage('build') {
      steps {
        echo 'build the code'
      }
    }

    stage('deploy') {
      steps {
        echo 'deploy the code'
      }
    }

  }
}